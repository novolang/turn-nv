// turnsess.nv — a TURN client's allocation, its permissions and its channels,
// as a session the caller drives (RFC 8656).
//
// `[]` THROUGHOUT and `@tier(embedded)` on all of it, and no allocation.  The
// package has no socket and no clock and chooses no random number.  A program
// sends the datagrams this module builds, hands it the datagrams that come
// back, tells it how many milliseconds passed, and supplies a fresh
// transaction ID each time a request may be built.
//
// WHAT THE SESSION KEEPS, from sections 6, 9 and 12 of RFC 8656.
//
//   the allocation   asked for with Allocate, kept alive with Refresh, ended
//                    with a Refresh of lifetime 0.  The server grants a
//                    lifetime, 600 seconds by default, and the session
//                    refreshes when half of it has passed.
//   permissions      one per peer IP address (the port is not part of it),
//                    installed by CreatePermission, 300 seconds long.  A peer
//                    can send to the relayed address only while it has one.
//                    The session asks again when 60 seconds are left.
//   channel bindings one per peer transport address, installed by ChannelBind,
//                    600 seconds long, refreshed when 60 seconds are left.  A
//                    ChannelBind also installs the permission of its peer.
//                    After a binding expires the channel number and the peer
//                    stay reserved for 5 minutes (section 12), which the
//                    session counts as a quarantine.
//
// UP TO SIX REQUESTS ARE IN FLIGHT AT ONCE, each with its own transaction ID
// and retransmission timer: the Allocate or Refresh, and the CreatePermission
// and ChannelBind requests.  A request is retransmitted, with the same bytes,
// at 0, 500, 1500, ... ms (RFC 8489 section 6.2.1, over a datagram transport;
// once over a reliable one) and fails after 39500 ms.
//
// CREDENTIALS.  The first Allocate carries none.  The server answers 401 with
// a realm and a nonce, and the session sends the request again with USERNAME,
// REALM, NONCE and MESSAGE-INTEGRITY under the long-term key (RFC 8489
// section 9.2).  A 438 (Stale Nonce) is answered with the new nonce, up to
// three times for a request.  A success response to an authenticated request
// that does not verify is ignored and its timer goes on.
//
// ONE DATAGRAM AT A TIME.  `tick` and `on_datagram` answer a `TurnStep` that
// carries at most one datagram to send.  When a step is `TURN_EV_SEND` or
// `TURN_EV_RESEND` the datagram is in `out`.  A caller that has told the
// session about elapsed time asks again with an elapsed time of 0 until the
// answer is `TURN_EV_NONE`, since several timers can fall due together.

use stunwire
use stunmac
use stunclient
use turnwire
use turnattr

// Nothing sent.
pub const TURN_IDLE = 0
// An Allocate request is in flight.
pub const TURN_ALLOCATING = 1
// The server holds an allocation.
pub const TURN_ALLOCATED = 2
// A Refresh of lifetime 0 is in flight.
pub const TURN_CLOSING = 3
// The allocation was released.
pub const TURN_CLOSED = 4
// The allocation failed or ran out; `last_error` says why.
pub const TURN_FAILED = 5

// Nothing to do.
pub const TURN_EV_NONE = 0
// Send the request just built into `out`.
pub const TURN_EV_SEND = 1
// Send the request of the transaction in flight again, byte for byte, from `out`.
pub const TURN_EV_RESEND = 2
// The allocation succeeded; the relayed address is in the session.
pub const TURN_EV_ALLOCATED = 3
// A Refresh of the allocation succeeded.
pub const TURN_EV_REFRESHED = 4
// A Refresh with a lifetime of 0 succeeded.
pub const TURN_EV_CLOSED = 5
// The allocation failed or expired; `code` says why.
pub const TURN_EV_FAILED = 6
// A permission was installed or refreshed; `peer` is its address.
pub const TURN_EV_PERMISSION = 7
// A channel was bound or refreshed; `peer` is its peer and `code` the channel.
pub const TURN_EV_BOUND = 8
// Application data arrived: `n` bytes in the data buffer from `peer`; `code` is
// the channel number, or 0 when the data came in a Data indication.
pub const TURN_EV_DATA = 9
// The server could not deliver to `peer`: `code` is the ICMP type times 256
// plus the ICMP code.
pub const TURN_EV_ICMP = 10
// A CreatePermission or ChannelBind request failed: `code` is the error code
// or a `TURN_ERR_` value, `peer` the peer.
pub const TURN_EV_REQUEST_FAILED = 11
// A permission expired, or a channel binding did; `peer` is its address.
pub const TURN_EV_EXPIRED = 12

// `last_error` after a request that no response answered: -1.
pub const TURN_ERR_TIMEOUT = -1
// A response lacked what it must carry: -2.
pub const TURN_ERR_BAD_RESPONSE = -2
// A username or password that did not fit: -3.
pub const TURN_ERR_ARGUMENT = -3
// The allocation ran out with no refresh answered: -4.
pub const TURN_ERR_EXPIRED = -4

// A call succeeded and a request is in `out`.
pub const TURN_OK = 0
// The session is not allocated, or not idle for an Allocate.
pub const TURN_ERR_STATE = -10
// There is no free row in the table of permissions, channels or requests.
pub const TURN_ERR_FULL = -11
// An argument is out of range: a channel number, a family, an option.
pub const TURN_ERR_RANGE = -12
// The channel number or the peer is held by another channel or peer.
pub const TURN_ERR_CONFLICT = -13
// The peer has no permission yet.
pub const TURN_ERR_PERMISSION = -14
// The data does not fit in a message.
pub const TURN_ERR_TOO_BIG = -15
// The peer is of another address family than the relayed address.
pub const TURN_ERR_FAMILY = -16
// A permission or channel for the peer already exists and is not near expiry.
pub const TURN_ALREADY = 1
// `send_data` sent a ChannelData message.
pub const TURN_SENT_CHANNEL = 2
// `send_data` sent a Send indication.
pub const TURN_SENT_INDICATION = 3

// The number of times a 438 is answered with the new nonce before the
// request fails.
pub const TURN_STALE_RETRIES = 3

// The length of a permission, in milliseconds: 300000.
pub const TURN_PERMISSION_MS = 300000
// The length of a channel binding, in milliseconds: 600000.
pub const TURN_CHANNEL_MS = 600000
// How long a channel number and its peer stay reserved after the binding
// expired, in milliseconds: 300000.
pub const TURN_QUARANTINE_MS = 300000
// How long before a permission or a channel runs out the session asks for
// it again, in milliseconds: 60000.
pub const TURN_MARGIN_MS = 60000
// How long the session waits to ask again after a refresh failed, in
// milliseconds: 30000.
pub const TURN_RETRY_MS = 30000

// The rows of the tables.
pub const TURN_SLOTS = 6
// The permissions a session holds.
pub const TURN_PERMS = 8
// The channels a session holds.
pub const TURN_CHANS = 8

// The kind of a request in flight, 1: Allocate.
pub const TURN_K_ALLOCATE = 1
// The kind of a request in flight, 2: Refresh.
pub const TURN_K_REFRESH = 2
// The kind of a request in flight, 3: CreatePermission.
pub const TURN_K_PERMISSION = 3
// The kind of a request in flight, 4: ChannelBind.
pub const TURN_K_BIND = 4

// A row of the permission table that is not used.
pub const TURN_ROW_FREE = 0
// A row whose request is in flight.
pub const TURN_ROW_PENDING = 1
// A row the server confirmed.
pub const TURN_ROW_ACTIVE = 2
// A channel whose binding expired and whose number and peer are reserved.
pub const TURN_ROW_QUARANTINE = 3

// What an Allocate request asks for.
pub @value
struct TurnOpts
    // 0 for the server's choice, 1 or 2 for REQUESTED-ADDRESS-FAMILY.
    family: Int
    // Whether to add ADDITIONAL-ADDRESS-FAMILY for IPv6.
    additional_v6: Bool
    // Whether to ask for an even port.
    even_port: Bool
    // Whether the even port request also reserves the next higher port.
    reserve_next: Bool
    // Whether to send a RESERVATION-TOKEN.
    has_token: Bool
    // The token.
    token: Int
    // Whether to send DONT-FRAGMENT.
    dont_fragment: Bool
    // The lifetime to ask for in seconds, 0 for the server's default.
    lifetime_s: Int

// A request in flight.
@value
struct TurnSlot
    // 0 for a free row, or one of the `TURN_K_` kinds.
    kind: Int
    // The transaction: its ID and retransmission timer.
    tx: stunclient.StunTx
    // The peer of a CreatePermission or ChannelBind.
    peer: stunwire.StunAddr
    // The channel of a ChannelBind.
    channel: Int
    // The lifetime a Refresh asks for; 0 releases the allocation.
    want: Int
    // How many 438 responses were answered with a new nonce.
    stale: Int
    // Whether the request is due to be sent again.
    resend: Bool
    // Whether the transaction ran out of time.
    timed_out: Bool

// A permission.
@value
struct TurnPerm
    // `TURN_ROW_FREE`, `TURN_ROW_PENDING` or `TURN_ROW_ACTIVE`.
    state: Int
    // The peer's address; the port is 0.
    addr: stunwire.StunAddr
    // Milliseconds until it expires.
    left_ms: Int
    // Milliseconds before the next try after a refresh failed, else 0.
    hold_ms: Int

// A channel binding.
@value
struct TurnChan
    // A `TURN_ROW_` state.
    state: Int
    // The channel number.
    channel: Int
    // The peer's transport address.
    peer: stunwire.StunAddr
    // Milliseconds until it expires, or until a quarantine ends.
    left_ms: Int
    // Milliseconds before the next try after a refresh failed, else 0.
    hold_ms: Int

// What a call to the session found out.
pub @value
struct TurnStep
    // One of the `TURN_EV_` events.
    event: Int
    // The peer an event is about, family 0 if none.
    peer: stunwire.StunAddr
    // The error code, channel number or ICMP value an event carries.
    code: Int
    // The number of bytes of data in the data buffer.
    n: Int

// A TURN client's session.
pub @value
struct TurnSession
    // `TURN_IDLE` through `TURN_FAILED`.
    state: Int
    // The username.
    user: stunwire.StunText
    // The password.
    secret: stunwire.StunText
    // The realm from the server's 401.
    realm: stunwire.StunText
    // The nonce from the server's latest 401 or 438.
    nonce: stunwire.StunText
    // The long-term key.
    key: stunmac.StunKey
    // Whether requests carry credentials.
    have_auth: Bool
    // What the Allocate asks for.
    opts: TurnOpts
    // The initial retransmission timeout in milliseconds.
    rto_ms: Int
    // Whether the transport is reliable.
    reliable: Bool
    // The first relayed transport address, family 0 until allocated.
    relayed: stunwire.StunAddr
    // The second relayed address when both families were asked for, else family 0.
    relayed2: stunwire.StunAddr
    // The client's address as the server sees it, family 0 if not sent.
    mapped: stunwire.StunAddr
    // The lifetime the server granted, in seconds.
    lifetime_s: Int
    // Milliseconds until the allocation expires.
    alloc_left_ms: Int
    // The RESERVATION-TOKEN the server sent for the next higher port.
    token: turnattr.TurnToken
    // The ADDRESS-ERROR-CODE the server sent for a family it did not allocate.
    addr_error: turnattr.TurnAddrError
    // The error code of the failure, or one of the `TURN_ERR_` values, or 0.
    last_error: Int
    // The requests in flight.
    slots: Vec[TurnSlot; 6]
    // The permissions.
    perms: Vec[TurnPerm; 8]
    // The channel bindings.
    chans: Vec[TurnChan; 8]

// An address of family 0.
@tier(embedded)
@no_alloc
fn no_addr() -> stunwire.StunAddr []
    stunwire.StunAddr { family: 0, port: 0, hi: 0, lo: 0 }

// A step with an event and nothing else.
@tier(embedded)
@no_alloc
fn step(event: Int) -> TurnStep []
    TurnStep { event: event, peer: no_addr(), code: 0, n: 0 }

// A step with an event, a peer and a code.
@tier(embedded)
@no_alloc
fn step_for(event: Int, peer: stunwire.StunAddr, code: Int) -> TurnStep []
    TurnStep { event: event, peer: peer, code: code, n: 0 }

// The options of an Allocate that asks for nothing but the transport.
pub @tier(embedded)
@no_alloc
fn default_options() -> TurnOpts []
    TurnOpts { family: 0, additional_v6: false, even_port: false, reserve_next: false,
               has_token: false, token: 0, dont_fragment: false, lifetime_s: 0 }

// A session for the given credentials.
//
// `rto_ms` is the initial retransmission timeout (0 for the default of 500)
// and `reliable` says whether the transport is TCP or TLS.  A username or a
// password longer than 128 bytes leaves the session `TURN_FAILED` with
// `last_error` of `TURN_ERR_ARGUMENT`.
//
// ```novo
// use turnsess
//
// fn main() [io]
//     let s = turnsess.session("alice", "secret", 0, false)
//     println("${s.state} ${s.slots.len()}")   // 0 0
// ```
pub @tier(embedded)
@no_alloc
fn session(user: Str, password: Str, rto_ms: Int, reliable: Bool) -> TurnSession []
    var u: stunwire.StunText = Vec.new()
    var p: stunwire.StunText = Vec.new()
    var state = TURN_IDLE
    var err = 0
    if not stunwire.set_text(var u, user) or not stunwire.set_text(var p, password)
        state = TURN_FAILED
        err = TURN_ERR_ARGUMENT
    TurnSession {
        state: state, user: u, secret: p, realm: Vec.new(), nonce: Vec.new(), key: Vec.new(),
        have_auth: false, opts: default_options(), rto_ms: rto_ms, reliable: reliable,
        relayed: no_addr(), relayed2: no_addr(), mapped: no_addr(), lifetime_s: 0,
        alloc_left_ms: 0, token: turnattr.TurnToken { present: false, value: 0 },
        addr_error: turnattr.TurnAddrError { present: false, family: 0, code: 0 },
        last_error: err, slots: Vec.new(), perms: Vec.new(), chans: Vec.new() }

// Choose what the Allocate asks for.  Answers false, leaving the options as
// they were, for a combination RFC 8656 section 7.1 refuses: both
// REQUESTED-ADDRESS-FAMILY and ADDITIONAL-ADDRESS-FAMILY, a family other than
// 1 or 2, a RESERVATION-TOKEN with EVEN-PORT, or a negative lifetime.
// The session must be idle.
pub @tier(embedded)
@no_alloc
fn set_options(var s: TurnSession, o: TurnOpts) -> Bool []
    if s.state != TURN_IDLE or o.lifetime_s < 0
        return false
    if o.family < 0 or o.family > 2
        return false
    if o.family != 0 and o.additional_v6
        return false
    if o.has_token and (o.even_port or o.reserve_next)
        return false
    s.opts = o
    true

// The row of the table of requests that is free, or -1.
@tier(embedded)
@no_alloc
fn free_slot(var s: TurnSession) -> Int []
    for i in 0..TURN_SLOTS
        if i >= s.slots.len()
            return i
        if s.slots[i].kind == 0
            return i
    -1

// The row of the table of requests whose transaction ID is `id`, or -1.
@tier(embedded)
@no_alloc
fn slot_of(var s: TurnSession, id: stunwire.StunTxid) -> Int []
    for i in 0..s.slots.len()
        if s.slots[i].kind != 0 and stunwire.txid_eq(s.slots[i].tx.id, id)
            return i
    -1

// Whether two addresses are the same IP address, whatever the port.
@tier(embedded)
@no_alloc
fn same_ip(x: stunwire.StunAddr, y: stunwire.StunAddr) -> Bool []
    x.family == y.family and x.hi == y.hi and x.lo == y.lo

// The row of the table of permissions that holds the IP address of `a`, or -1.
@tier(embedded)
@no_alloc
fn perm_of(var s: TurnSession, a: stunwire.StunAddr) -> Int []
    for i in 0..s.perms.len()
        if s.perms[i].state != TURN_ROW_FREE and same_ip(s.perms[i].addr, a)
            return i
    -1

// The row of the table of channels, in any state, that holds `channel`, or -1.
@tier(embedded)
@no_alloc
fn chan_of(var s: TurnSession, channel: Int) -> Int []
    for i in 0..s.chans.len()
        if s.chans[i].state != TURN_ROW_FREE and s.chans[i].channel == channel
            return i
    -1

// The row of the table of channels, in any state, whose peer is `a`, or -1.
@tier(embedded)
@no_alloc
fn chan_for(var s: TurnSession, a: stunwire.StunAddr) -> Int []
    for i in 0..s.chans.len()
        if s.chans[i].state != TURN_ROW_FREE and stunwire.addr_eq(s.chans[i].peer, a)
            return i
    -1

// The channel number bound to `peer`, or 0 when there is none that is bound
// or being bound.
//
// ```novo
// use stunwire
// use turnsess
//
// fn main() [io]
//     let s = turnsess.session("alice", "secret", 0, false)
//     println("${turnsess.channel_of(s, stunwire.addr_v4(192, 0, 2, 1, 5000))}")   // 0
// ```
pub @tier(embedded)
@no_alloc
fn channel_of(s: TurnSession, peer: stunwire.StunAddr) -> Int []
    for i in 0..s.chans.len()
        if (s.chans[i].state == TURN_ROW_ACTIVE or s.chans[i].state == TURN_ROW_PENDING)
                and stunwire.addr_eq(s.chans[i].peer, peer)
            return s.chans[i].channel
    0

// The lowest channel number, 0x4000 and up, that no row of the table holds.
// A table of eight rows holds eight numbers, so one of the first nine is free.
pub @tier(embedded)
@no_alloc
fn free_channel(var s: TurnSession) -> Int []
    for k in 0..TURN_CHANS
        if chan_of(var s, turnwire.TURN_CHANNEL_MIN + k) < 0
            return turnwire.TURN_CHANNEL_MIN + k
    turnwire.TURN_CHANNEL_MIN + TURN_CHANS

// Whether the peer has a permission the server confirmed.
pub @tier(embedded)
@no_alloc
fn has_permission(var s: TurnSession, peer: stunwire.StunAddr) -> Bool []
    let i = perm_of(var s, peer)
    i >= 0 and s.perms[i].state == TURN_ROW_ACTIVE

// Append the credentials and the integrity to a request, if the session has
// them.
@tier(embedded)
@no_alloc
fn finish(var s: TurnSession, var out: stunwire.StunMsg) []
    if s.have_auth
        let _ = stunwire.add_text(var out, stunwire.STUN_ATTR_USERNAME, var s.user)
        let _ = stunwire.add_text(var out, stunwire.STUN_ATTR_REALM, var s.realm)
        let _ = stunwire.add_text(var out, stunwire.STUN_ATTR_NONCE, var s.nonce)
        let _ = stunmac.add_integrity(var out, var s.key, false)

// The attributes of an Allocate request that the options name.
@tier(embedded)
@no_alloc
fn allocate_attrs(var s: TurnSession, var out: stunwire.StunMsg) []
    let _ = turnwire.add_requested_transport(var out, turnwire.TURN_TRANSPORT_UDP)
    if s.opts.family != 0
        let _ = turnattr.add_requested_family(var out, s.opts.family)
    if s.opts.additional_v6
        let _ = turnattr.add_additional_family(var out, stunwire.STUN_FAMILY_IPV6)
    if s.opts.has_token
        let _ = turnwire.add_reservation_token(var out, s.opts.token)
    else if s.opts.even_port
        let _ = turnwire.add_even_port(var out, s.opts.reserve_next)
    if s.opts.dont_fragment
        let _ = turnwire.add_dont_fragment(var out)
    if s.opts.lifetime_s > 0
        let _ = turnwire.add_lifetime(var out, s.opts.lifetime_s)

// Build the request of row `i` into `out`.  The same row builds the same
// bytes as long as the nonce is the same, which is what a retransmission is.
@tier(embedded)
@no_alloc
fn build(var s: TurnSession, var out: stunwire.StunMsg, i: Int) []
    let sl = s.slots[i]
    var method = turnwire.TURN_ALLOCATE
    if sl.kind == TURN_K_REFRESH
        method = turnwire.TURN_REFRESH
    else if sl.kind == TURN_K_PERMISSION
        method = turnwire.TURN_CREATE_PERMISSION
    else if sl.kind == TURN_K_BIND
        method = turnwire.TURN_CHANNEL_BIND
    let _ = stunwire.begin(var out, stunwire.STUN_REQUEST, method, sl.tx.id)
    if sl.kind == TURN_K_ALLOCATE
        allocate_attrs(var s, var out)
    else if sl.kind == TURN_K_REFRESH
        let _ = turnwire.add_lifetime(var out, sl.want)
    else if sl.kind == TURN_K_PERMISSION
        let _ = turnwire.add_peer(var out, sl.peer, sl.tx.id)
    else
        let _ = turnwire.add_channel_number(var out, sl.channel)
        let _ = turnwire.add_peer(var out, sl.peer, sl.tx.id)
    finish(var s, var out)

// Put a new request in the table, build it into `out` and start its timer.
// Answers `TURN_OK` or `TURN_ERR_FULL`.
@tier(embedded)
@no_alloc
fn start(var s: TurnSession, var out: stunwire.StunMsg, kind: Int, peer: stunwire.StunAddr,
         channel: Int, want: Int, id: stunwire.StunTxid) -> Int []
    let i = free_slot(var s)
    if i < 0
        return TURN_ERR_FULL
    let row = TurnSlot { kind: kind, tx: stunclient.tx_begin(id, s.rto_ms, s.reliable), peer: peer,
                         channel: channel, want: want, stale: 0, resend: false, timed_out: false }
    if i >= s.slots.len()
        let _ = s.slots.push(row)
    else
        s.slots[i] = row
    build(var s, var out, i)
    TURN_OK

// Build the first Allocate request into `out`.
//
// `id` is a fresh random transaction ID.  The session must be idle.  Answers
// `TURN_OK`, after which the session is `TURN_ALLOCATING`, or `TURN_ERR_STATE`.
pub @tier(embedded)
@no_alloc
fn allocate(var s: TurnSession, var out: stunwire.StunMsg, id: stunwire.StunTxid) -> Int []
    if s.state != TURN_IDLE
        return TURN_ERR_STATE
    let r = start(var s, var out, TURN_K_ALLOCATE, no_addr(), 0, 0, id)
    s.state = TURN_ALLOCATING
    r

// Release the allocation: build a Refresh with a lifetime of 0 into `out`.
//
// The session must be allocated.  Answers `TURN_OK`, `TURN_ERR_STATE` or
// `TURN_ERR_FULL`.
pub @tier(embedded)
@no_alloc
fn release(var s: TurnSession, var out: stunwire.StunMsg, id: stunwire.StunTxid) -> Int []
    if s.state != TURN_ALLOCATED
        return TURN_ERR_STATE
    let r = start(var s, var out, TURN_K_REFRESH, no_addr(), 0, 0, id)
    if r == TURN_OK
        s.state = TURN_CLOSING
    r

// Whether an address is of the family of one of the relayed addresses.
@tier(embedded)
@no_alloc
fn family_ok(var s: TurnSession, a: stunwire.StunAddr) -> Bool []
    a.family != 0 and (a.family == s.relayed.family or a.family == s.relayed2.family)

// Ask for a permission for the IP address of `peer`.
//
// Answers `TURN_OK` with the CreatePermission request in `out`, or
// `TURN_ALREADY` when a permission exists that has more than the refresh
// margin left, `TURN_ERR_STATE`, `TURN_ERR_FAMILY` for a peer of another
// family than the relayed address, or `TURN_ERR_FULL`.  A permission lasts
// 300 seconds, and the session asks for it again before it ends.
pub @tier(embedded)
@no_alloc
fn permit(var s: TurnSession, var out: stunwire.StunMsg, peer: stunwire.StunAddr,
          id: stunwire.StunTxid) -> Int []
    if s.state != TURN_ALLOCATED
        return TURN_ERR_STATE
    if not family_ok(var s, peer)
        return TURN_ERR_FAMILY
    var i = perm_of(var s, peer)
    if i >= 0 and s.perms[i].state == TURN_ROW_ACTIVE and s.perms[i].left_ms > TURN_MARGIN_MS
        return TURN_ALREADY
    if i < 0
        i = free_perm(var s)
        if i < 0
            return TURN_ERR_FULL
    let row = TurnPerm { state: TURN_ROW_PENDING, addr: ip_only(peer), left_ms: 0, hold_ms: 0 }
    let r = start(var s, var out, TURN_K_PERMISSION, ip_only(peer), 0, 0, id)
    if r == TURN_OK
        if i >= s.perms.len()
            let _ = s.perms.push(row)
        else
            s.perms[i] = row
    r

// The address of `a` with its port 0, as a permission names it.
@tier(embedded)
@no_alloc
fn ip_only(a: stunwire.StunAddr) -> stunwire.StunAddr []
    stunwire.StunAddr { family: a.family, port: 0, hi: a.hi, lo: a.lo }

// The row of the table of permissions that is free, or -1.
@tier(embedded)
@no_alloc
fn free_perm(var s: TurnSession) -> Int []
    for i in 0..TURN_PERMS
        if i >= s.perms.len()
            return i
        if s.perms[i].state == TURN_ROW_FREE
            return i
    -1

// The row of the table of channels that is free, or -1.
@tier(embedded)
@no_alloc
fn free_chan(var s: TurnSession) -> Int []
    for i in 0..TURN_CHANS
        if i >= s.chans.len()
            return i
        if s.chans[i].state == TURN_ROW_FREE
            return i
    -1

// Bind `channel` to `peer`.
//
// The channel is 0x4000 through 0x4FFF, and `free_channel` names one that is
// free.  A channel number is held by one peer and a peer by one channel;
// asking for a number or a peer that another holds, or that expired less than
// 5 minutes ago with another, answers `TURN_ERR_CONFLICT` (RFC 8656 section
// 12).  Binding the same pair again refreshes the binding.  Answers
// `TURN_OK` with the ChannelBind request in `out`, `TURN_ERR_STATE`,
// `TURN_ERR_RANGE`, `TURN_ERR_FAMILY`, `TURN_ERR_CONFLICT` or
// `TURN_ERR_FULL`.
pub @tier(embedded)
@no_alloc
fn bind_channel(var s: TurnSession, var out: stunwire.StunMsg, channel: Int,
                peer: stunwire.StunAddr, id: stunwire.StunTxid) -> Int []
    if s.state != TURN_ALLOCATED
        return TURN_ERR_STATE
    if not turnwire.channel_ok(channel)
        return TURN_ERR_RANGE
    if not family_ok(var s, peer)
        return TURN_ERR_FAMILY
    let by_number = chan_of(var s, channel)
    let by_peer = chan_for(var s, peer)
    if by_number >= 0 and not stunwire.addr_eq(s.chans[by_number].peer, peer)
        return TURN_ERR_CONFLICT
    if by_peer >= 0 and s.chans[by_peer].channel != channel
        return TURN_ERR_CONFLICT
    var i = by_number
    if i < 0
        i = free_chan(var s)
        if i < 0
            return TURN_ERR_FULL
    let row = TurnChan { state: TURN_ROW_PENDING, channel: channel, peer: peer, left_ms: 0, hold_ms: 0 }
    let r = start(var s, var out, TURN_K_BIND, peer, channel, 0, id)
    if r == TURN_OK
        if i >= s.chans.len()
            let _ = s.chans.push(row)
        else
            s.chans[i] = row
    r

// Forget the permission and the channel of a peer, on this side only.
//
// The server keeps what it installed until it expires, so a channel that was
// bound stays reserved for its remaining time and 5 minutes more, and cannot
// be bound to another peer before then.
pub @tier(embedded)
@no_alloc
fn forget(var s: TurnSession, peer: stunwire.StunAddr) []
    let p = perm_of(var s, peer)
    if p >= 0
        s.perms[p].state = TURN_ROW_FREE
    let c = chan_for(var s, peer)
    if c >= 0
        if s.chans[c].state == TURN_ROW_ACTIVE
            s.chans[c].left_ms = s.chans[c].left_ms + TURN_QUARANTINE_MS
            s.chans[c].state = TURN_ROW_QUARANTINE
        else if s.chans[c].state == TURN_ROW_PENDING
            s.chans[c].state = TURN_ROW_FREE
    for i in 0..s.slots.len()
        if s.slots[i].kind >= TURN_K_PERMISSION and same_ip(s.slots[i].peer, peer)
            s.slots[i].kind = 0

// Build a message to send application data to a peer.
//
// The datagram is a ChannelData message when a channel is bound to the peer
// and a Send indication when none is.  A channel counts as bound once the
// server confirmed it; until then the Send indication is used, as RFC 8656
// section 12 advises.  The Send indication needs a permission the server
// confirmed, since the server drops the data of one without; DONT-FRAGMENT
// is added when the options asked for it.  `id` is the transaction ID of a
// Send indication, which gets no response.  Over a reliable transport the
// ChannelData message is padded to a multiple of four.
//
// Answers `TURN_SENT_CHANNEL` or `TURN_SENT_INDICATION` with the datagram in
// `out`, or `TURN_ERR_STATE`, `TURN_ERR_PERMISSION` or `TURN_ERR_TOO_BIG`.
pub @tier(embedded)
@no_alloc
fn send_data(var s: TurnSession, var out: stunwire.StunMsg, peer: stunwire.StunAddr,
             var src: stunwire.StunMsg, off: Int, n: Int, id: stunwire.StunTxid) -> Int []
    if s.state != TURN_ALLOCATED
        return TURN_ERR_STATE
    let c = chan_for(var s, peer)
    if c >= 0 and s.chans[c].state == TURN_ROW_ACTIVE
        if turnwire.channel_data(var out, s.chans[c].channel, var src, off, n, s.reliable)
            return TURN_SENT_CHANNEL
        return TURN_ERR_TOO_BIG
    if not has_permission(var s, peer)
        return TURN_ERR_PERMISSION
    if not turnwire.send_indication(var out, id, peer, var src, off, n)
        return TURN_ERR_TOO_BIG
    if s.opts.dont_fragment and not turnwire.add_dont_fragment(var out)
        return TURN_ERR_TOO_BIG
    TURN_SENT_INDICATION

// End every request and row, as an allocation that is gone has no use for them.
@tier(embedded)
@no_alloc
fn clear_tables(var s: TurnSession) []
    s.slots.clear()
    s.perms.clear()
    s.chans.clear()

// Fail the whole allocation with a reason.
@tier(embedded)
@no_alloc
fn fail_all(var s: TurnSession, code: Int) -> TurnStep []
    s.state = TURN_FAILED
    s.last_error = code
    s.alloc_left_ms = 0
    clear_tables(var s)
    TurnStep { event: TURN_EV_FAILED, peer: no_addr(), code: code, n: 0 }

// End the request in row `i` with an error: the allocation fails for an
// Allocate or a Refresh, and the row of a permission or a channel that was
// never confirmed is freed.
@tier(embedded)
@no_alloc
fn fail_slot(var s: TurnSession, i: Int, code: Int) -> TurnStep []
    let sl = s.slots[i]
    s.slots[i].kind = 0
    if sl.kind == TURN_K_ALLOCATE or sl.kind == TURN_K_REFRESH
        return fail_all(var s, code)
    // A row that was never confirmed goes with its request.  A row the
    // server confirmed stays until it runs out, and the next refresh tries
    // again.
    if sl.kind == TURN_K_PERMISSION
        let p = perm_of(var s, sl.peer)
        if p >= 0 and s.perms[p].state == TURN_ROW_PENDING
            s.perms[p].state = TURN_ROW_FREE
        else if p >= 0
            s.perms[p].hold_ms = TURN_RETRY_MS
    else
        let c = chan_of(var s, sl.channel)
        if c >= 0 and s.chans[c].state == TURN_ROW_PENDING
            s.chans[c].state = TURN_ROW_FREE
        else if c >= 0
            s.chans[c].hold_ms = TURN_RETRY_MS
        // RFC 8656 section 12.3: a 400 to a ChannelBind says the two ends
        // disagree about the channels, and the advice is to start afresh.
        if code == stunwire.STUN_E_BAD_REQUEST
            return fail_all(var s, code)
    step_for(TURN_EV_REQUEST_FAILED, sl.peer, code)

// Answer a 401 or a 438: take the realm and the nonce from the response,
// derive the key and build the request of row `i` again under a new
// transaction ID.
@tier(embedded)
@no_alloc
fn retry(var s: TurnSession, var m: stunwire.StunMsg, h: stunwire.StunHeader,
         var out: stunwire.StunMsg, i: Int, next: stunwire.StunTxid) -> TurnStep []
    let realm = stunwire.find(var m, h, stunwire.STUN_ATTR_REALM)
    let nonce = stunwire.find(var m, h, stunwire.STUN_ATTR_NONCE)
    if not stunwire.read_text(var m, nonce, var s.nonce)
        return fail_slot(var s, i, TURN_ERR_BAD_RESPONSE)
    if stunwire.present(realm)
        if not stunwire.read_text(var m, realm, var s.realm)
            return fail_slot(var s, i, TURN_ERR_BAD_RESPONSE)
    if s.realm.len() == 0
        return fail_slot(var s, i, TURN_ERR_BAD_RESPONSE)
    let _ = stunmac.long_term_key_text(stunmac.STUN_HASH_MD5, var s.user, var s.realm, var s.secret,
                                       var s.key)
    s.have_auth = true
    s.slots[i].tx = stunclient.tx_begin(next, s.rto_ms, s.reliable)
    s.slots[i].resend = false
    build(var s, var out, i)
    step(TURN_EV_SEND)

// Take a success response for row `i`.
@tier(embedded)
@no_alloc
fn succeed(var s: TurnSession, var m: stunwire.StunMsg, h: stunwire.StunHeader,
           i: Int) -> TurnStep []
    let sl = s.slots[i]
    s.slots[i].kind = 0
    if sl.kind == TURN_K_PERMISSION
        let p = perm_of(var s, sl.peer)
        if p >= 0
            s.perms[p].state = TURN_ROW_ACTIVE
            s.perms[p].left_ms = TURN_PERMISSION_MS
            s.perms[p].hold_ms = 0
        return step_for(TURN_EV_PERMISSION, sl.peer, 0)
    if sl.kind == TURN_K_BIND
        return bound(var s, sl)
    let life = turnwire.read_lifetime(var m, h)
    if life < 0
        return fail_all(var s, TURN_ERR_BAD_RESPONSE)
    if sl.kind == TURN_K_REFRESH
        if sl.want == 0
            s.state = TURN_CLOSED
            clear_tables(var s)
            return step(TURN_EV_CLOSED)
        s.lifetime_s = life
        s.alloc_left_ms = life * 1000
        return step(TURN_EV_REFRESHED)
    let relayed = turnwire.read_relayed(var m, h)
    if relayed.family == 0
        return fail_all(var s, TURN_ERR_BAD_RESPONSE)
    s.relayed = relayed
    s.relayed2 = turnattr.nth_address(var m, h, turnwire.TURN_ATTR_XOR_RELAYED_ADDRESS, 1)
    s.mapped = stunclient.mapped_address(var m, h)
    s.token = turnattr.read_token(var m, h)
    s.addr_error = turnattr.read_address_error(var m, h)
    s.lifetime_s = life
    s.alloc_left_ms = life * 1000
    s.state = TURN_ALLOCATED
    step(TURN_EV_ALLOCATED)

// A ChannelBind succeeded for the request `sl`: the channel is bound and the
// permission of its peer is installed or refreshed.
@tier(embedded)
@no_alloc
fn bound(var s: TurnSession, sl: TurnSlot) -> TurnStep []
    let c = chan_of(var s, sl.channel)
    if c >= 0
        s.chans[c].state = TURN_ROW_ACTIVE
        s.chans[c].left_ms = TURN_CHANNEL_MS
        s.chans[c].hold_ms = 0
    var p = perm_of(var s, sl.peer)
    if p < 0
        p = free_perm(var s)
        if p >= 0
            let row = TurnPerm { state: TURN_ROW_ACTIVE, addr: ip_only(sl.peer), left_ms: TURN_PERMISSION_MS,
                                hold_ms: 0 }
            if p >= s.perms.len()
                let _ = s.perms.push(row)
            else
                s.perms[p] = row
    else
        s.perms[p].state = TURN_ROW_ACTIVE
        s.perms[p].left_ms = TURN_PERMISSION_MS
        s.perms[p].hold_ms = 0
    step_for(TURN_EV_BOUND, sl.peer, sl.channel)

// Take a response for row `i`.
@tier(embedded)
@no_alloc
fn on_response(var s: TurnSession, var m: stunwire.StunMsg, h: stunwire.StunHeader,
               var out: stunwire.StunMsg, i: Int, next: stunwire.StunTxid) -> TurnStep []
    if h.class == stunwire.STUN_SUCCESS
        if s.have_auth and stunmac.check_integrity(var m, h, var s.key, false) != stunmac.STUN_CHECK_OK
            return step(TURN_EV_NONE)
        return succeed(var s, var m, h, i)
    if h.class != stunwire.STUN_ERROR
        return step(TURN_EV_NONE)
    let code = stunwire.read_error(var m, stunwire.find(var m, h, stunwire.STUN_ATTR_ERROR_CODE))
    if code == stunwire.STUN_E_UNAUTHENTICATED and not s.have_auth
        return retry(var s, var m, h, var out, i, next)
    if code == stunwire.STUN_E_STALE_NONCE and s.have_auth and s.slots[i].stale < TURN_STALE_RETRIES
        s.slots[i].stale = s.slots[i].stale + 1
        return retry(var s, var m, h, var out, i, next)
    fail_slot(var s, i, code)

// Copy `n` bytes of a message from index `off` into `data`, replacing what
// it held.
@tier(embedded)
@no_alloc
fn copy_out(var m: stunwire.StunMsg, off: Int, n: Int, var data: stunwire.StunMsg) []
    data.clear()
    for k in 0..n
        let _ = data.push(m[off + k])

// Take a ChannelData message.
@tier(embedded)
@no_alloc
fn on_channel_data(var s: TurnSession, var m: stunwire.StunMsg,
                   var data: stunwire.StunMsg) -> TurnStep []
    let f = turnwire.parse_channel_data(var m)
    if f.status != turnwire.TURN_CD_OK
        return step(TURN_EV_NONE)
    let c = chan_of(var s, f.channel)
    if c < 0 or s.chans[c].state != TURN_ROW_ACTIVE and s.chans[c].state != TURN_ROW_PENDING
        return step(TURN_EV_NONE)
    copy_out(var m, f.data_off, f.len, var data)
    TurnStep { event: TURN_EV_DATA, peer: s.chans[c].peer, code: f.channel, n: f.len }

// Take a Data indication: the data of a peer, or the ICMP error for one.
@tier(embedded)
@no_alloc
fn on_data_indication(var s: TurnSession, var m: stunwire.StunMsg, h: stunwire.StunHeader,
                      var data: stunwire.StunMsg) -> TurnStep []
    let peer = turnwire.read_peer(var m, h)
    if peer.family == 0 or not has_permission(var s, peer)
        return step(TURN_EV_NONE)
    let icmp = turnattr.read_icmp(var m, h)
    if icmp.present
        return step_for(TURN_EV_ICMP, peer, icmp.kind * 256 + icmp.code)
    let a = turnwire.find_data(var m, h)
    if not stunwire.present(a)
        return step(TURN_EV_NONE)
    copy_out(var m, a.off, a.len, var data)
    TurnStep { event: TURN_EV_DATA, peer: peer, code: 0, n: a.len }

// Hand the session a datagram that came from the server.
//
// A ChannelData message, or a Data indication from a peer that has a
// permission, answers `TURN_EV_DATA` with the data copied to `data`.  A
// Data indication with an ICMP attribute answers `TURN_EV_ICMP`.  A response
// is matched to the request in flight by its transaction ID and answers the
// event for that request: `TURN_EV_ALLOCATED`, `TURN_EV_REFRESHED`,
// `TURN_EV_CLOSED`, `TURN_EV_PERMISSION`, `TURN_EV_BOUND`, `TURN_EV_FAILED`
// or `TURN_EV_REQUEST_FAILED`; a 401 or 438 answers `TURN_EV_SEND` with the
// request again, under `next`, in `out`.  Anything else, including a
// success whose integrity does not verify, answers `TURN_EV_NONE`.
pub @tier(embedded)
@no_alloc
fn on_datagram(var s: TurnSession, var m: stunwire.StunMsg, var out: stunwire.StunMsg,
               var data: stunwire.StunMsg, next: stunwire.StunTxid) -> TurnStep []
    if s.state == TURN_IDLE or s.state == TURN_CLOSED or s.state == TURN_FAILED
        return step(TURN_EV_NONE)
    if turnwire.is_channel_data(var m)
        return on_channel_data(var s, var m, var data)
    let h = stunwire.parse(var m)
    if h.status != stunwire.STUN_PARSE_OK
        return step(TURN_EV_NONE)
    if h.class == stunwire.STUN_INDICATION
        if h.method == turnwire.TURN_DATA
            return on_data_indication(var s, var m, h, var data)
        return step(TURN_EV_NONE)
    let i = slot_of(var s, h.txid)
    if i < 0
        return step(TURN_EV_NONE)
    on_response(var s, var m, h, var out, i, next)

// A hold of `hold_ms` milliseconds after `elapsed_ms` have passed.
@tier(embedded)
@no_alloc
fn later(hold_ms: Int, elapsed_ms: Int) -> Int []
    if hold_ms > elapsed_ms
        return hold_ms - elapsed_ms
    0

// Move every timer on by `elapsed_ms`.
@tier(embedded)
@no_alloc
fn advance(var s: TurnSession, elapsed_ms: Int) []
    for i in 0..s.slots.len()
        if s.slots[i].kind != 0
            let a = stunclient.tx_tick(var s.slots[i].tx, elapsed_ms)
            if a == stunclient.STUN_TICK_RETRANSMIT
                s.slots[i].resend = true
            else if a == stunclient.STUN_TICK_GIVE_UP
                s.slots[i].timed_out = true
    for i in 0..s.perms.len()
        if s.perms[i].state == TURN_ROW_ACTIVE
            s.perms[i].left_ms = s.perms[i].left_ms - elapsed_ms
            s.perms[i].hold_ms = later(s.perms[i].hold_ms, elapsed_ms)
    for i in 0..s.chans.len()
        if s.chans[i].state == TURN_ROW_ACTIVE or s.chans[i].state == TURN_ROW_QUARANTINE
            s.chans[i].left_ms = s.chans[i].left_ms - elapsed_ms
            s.chans[i].hold_ms = later(s.chans[i].hold_ms, elapsed_ms)
            if s.chans[i].state == TURN_ROW_QUARANTINE and s.chans[i].left_ms <= 0
                s.chans[i].state = TURN_ROW_FREE
    if s.state == TURN_ALLOCATED or s.state == TURN_CLOSING
        s.alloc_left_ms = s.alloc_left_ms - elapsed_ms

// Whether a request of this kind for this peer or channel is in flight.
@tier(embedded)
@no_alloc
fn in_flight(var s: TurnSession, kind: Int, peer: stunwire.StunAddr, channel: Int) -> Bool []
    for i in 0..s.slots.len()
        if s.slots[i].kind == kind
            if kind == TURN_K_PERMISSION and same_ip(s.slots[i].peer, peer)
                return true
            if kind == TURN_K_BIND and s.slots[i].channel == channel
                return true
            if kind == TURN_K_REFRESH
                return true
    false

// The one thing due now, if there is one.
@tier(embedded)
@no_alloc
fn next_action(var s: TurnSession, var out: stunwire.StunMsg,
               next: stunwire.StunTxid) -> TurnStep []
    for i in 0..s.slots.len()
        if s.slots[i].kind != 0 and s.slots[i].resend
            s.slots[i].resend = false
            build(var s, var out, i)
            return step(TURN_EV_RESEND)
    for i in 0..s.slots.len()
        if s.slots[i].kind != 0 and s.slots[i].timed_out
            return fail_slot(var s, i, TURN_ERR_TIMEOUT)
    if (s.state == TURN_ALLOCATED or s.state == TURN_CLOSING) and s.alloc_left_ms <= 0
        return fail_all(var s, TURN_ERR_EXPIRED)
    for i in 0..s.perms.len()
        if s.perms[i].state == TURN_ROW_ACTIVE and s.perms[i].left_ms <= 0
            s.perms[i].state = TURN_ROW_FREE
            return step_for(TURN_EV_EXPIRED, s.perms[i].addr, 0)
    for i in 0..s.chans.len()
        if s.chans[i].state == TURN_ROW_ACTIVE and s.chans[i].left_ms <= 0
            s.chans[i].state = TURN_ROW_QUARANTINE
            s.chans[i].left_ms = TURN_QUARANTINE_MS
            return step_for(TURN_EV_EXPIRED, s.chans[i].peer, s.chans[i].channel)
    refresh_due(var s, var out, next)

// Start the refresh that is due now, if there is one.
@tier(embedded)
@no_alloc
fn refresh_due(var s: TurnSession, var out: stunwire.StunMsg,
               next: stunwire.StunTxid) -> TurnStep []
    if s.state != TURN_ALLOCATED
        return step(TURN_EV_NONE)
    if s.alloc_left_ms * 2 <= s.lifetime_s * 1000 and not in_flight(var s, TURN_K_REFRESH, no_addr(), 0)
        if start(var s, var out, TURN_K_REFRESH, no_addr(), 0, s.lifetime_s, next) == TURN_OK
            return step(TURN_EV_SEND)
    for i in 0..s.perms.len()
        if s.perms[i].state == TURN_ROW_ACTIVE and s.perms[i].left_ms <= TURN_MARGIN_MS
                and s.perms[i].hold_ms == 0 and not in_flight(var s, TURN_K_PERMISSION, s.perms[i].addr, 0)
            if start(var s, var out, TURN_K_PERMISSION, s.perms[i].addr, 0, 0, next) == TURN_OK
                return step(TURN_EV_SEND)
    for i in 0..s.chans.len()
        if s.chans[i].state == TURN_ROW_ACTIVE and s.chans[i].left_ms <= TURN_MARGIN_MS
                and s.chans[i].hold_ms == 0 and not in_flight(var s, TURN_K_BIND, no_addr(), s.chans[i].channel)
            if start(var s, var out, TURN_K_BIND, s.chans[i].peer, s.chans[i].channel, 0, next) == TURN_OK
                return step(TURN_EV_SEND)
    step(TURN_EV_NONE)

// Tell the session that `elapsed_ms` milliseconds passed and learn what to do.
//
// The retransmission timers of the requests in flight run, the lifetimes of
// the allocation, the permissions and the channels shorten, and the session
// answers the first thing that has fallen due, in this order: a request to
// send again (`TURN_EV_RESEND`, the bytes in `out`), a request that ran out
// of time (the allocation fails, or `TURN_EV_REQUEST_FAILED`), an allocation
// that expired (`TURN_EV_FAILED`), a permission or channel that expired
// (`TURN_EV_EXPIRED`), and then a refresh to send: the allocation at half its
// lifetime, a permission or a channel with 60 seconds left (`TURN_EV_SEND`,
// the request in `out` under the transaction ID `next`).  Call again with an
// elapsed time of 0 until it answers `TURN_EV_NONE`.
pub @tier(embedded)
@no_alloc
fn tick(var s: TurnSession, elapsed_ms: Int, var out: stunwire.StunMsg,
        next: stunwire.StunTxid) -> TurnStep []
    if elapsed_ms > 0
        advance(var s, elapsed_ms)
    next_action(var s, var out, next)
